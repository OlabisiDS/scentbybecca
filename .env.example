# Copy this file to .env.local and fill in your own values. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose or share this key.
SUPABASE_SERVICE_ROLE_KEY=
# The one email address allowed into the admin area (must match the user you create in Supabase Auth).
ADMIN_EMAIL=
# Your live site address, for link previews and the sitemap. Example: https://www.yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
