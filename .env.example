# Copy this file to .env.local and fill in your own values. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose or share this key.
SUPABASE_SERVICE_ROLE_KEY=
# The one email address allowed into the admin area (must match the user you create in Supabase Auth).
ADMIN_EMAIL=
# Your live site address, for link previews and the sitemap. Example: https://www.yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: order emails through Resend (resend.com). Leave empty to switch order emails off.
RESEND_API_KEY=
# Example: ScentbyBecca <orders@yourdomain.com>  (the domain must be verified in Resend)
EMAIL_FROM=
# Optional: where new-order alerts go. Defaults to ADMIN_EMAIL.
ADMIN_NOTIFY_EMAIL=
